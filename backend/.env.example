# Supabase: Dashboard → Project Settings → API
# Database: Dashboard → Project Settings → Database → Connection string

# --- Supabase (Auth + API) ---

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Postgres (Alembic + direct DB access) ---

# Use the DIRECT connection (host: db.<ref>.supabase.co).
# Do NOT use the transaction pooler URL (pooler.supabase.com) — migrations require a session connection.
# URL-encode special characters in the password.

DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# --- OpenAI (needed once the LLM / embedding layer is wired up) ---

OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
INGESTION_CHUNK_TOKENS=1024
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_GROUNDING_MODEL=gpt-4o-mini

# --- Grounded answers (validate before streaming) ---
# Applies to reasoning models in answering, numeric selection and judging.
# For gpt-5.4-mini in this Chat Completions integration, use none and 4000 answer tokens.
ASSISTANT_REASONING_EFFORT=minimal
OPENAI_AGENT_REQUEST_LIMIT=20
ASSISTANT_OUTPUT_RETRIES=1
ASSISTANT_GROUNDING_REPAIRS=1
ASSISTANT_TOOL_CALLS=12
ASSISTANT_SEARCH_CALLS=4
ASSISTANT_READ_BATCH=5
ASSISTANT_MAX_CHUNKS=50
ASSISTANT_EVIDENCE_CHARS=48000
ASSISTANT_TOOL_CHARS=12000
ASSISTANT_USER_CONCURRENT_TURNS=2
ASSISTANT_USER_TURNS_PER_HOUR=60
ASSISTANT_COMPARISON_TARGET_CHARS=3000
ASSISTANT_MAX_CLAIMS=20
ASSISTANT_CLAIM_REFS=8
ASSISTANT_OUTPUT_TOKENS=3000
GROUNDING_OUTPUT_TOKENS=2000
ASSISTANT_DEADLINE_SECONDS=120
ASSISTANT_HISTORY_PAIRS=6
ASSISTANT_HISTORY_CHARS=12000

# --- Retrieval (hybrid search defaults) ---

RETRIEVAL_CANDIDATE_K=50
RETRIEVAL_TOP_K=10
RETRIEVAL_RRF_K=60
RETRIEVAL_NEIGHBOR_RADIUS=1
RETRIEVAL_FTS_CONFIG=english
RETRIEVAL_FTS_KEYWORD_MODEL=gpt-4o-mini
OPENAI_TITLE_MODEL=gpt-4o-mini
RETRIEVAL_FTS_KEYWORD_MIN=3
RETRIEVAL_FTS_KEYWORD_MAX=5
RETRIEVAL_FTS_KEYWORD_FAST_PATH_TOKENS=5

# --- Server ---

# Comma-separated browser origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173

# Public demo: enable only after migration, isolation and accounting review.
DEMO_ENABLED=false
DEMO_DAILY_BUDGET_USD=1.00
DEMO_ATTEMPTS_PER_VISITOR=3
DEMO_DAILY_ADMISSIONS=100
